doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Sistema Antiplagio UNEGIA
    script(src="https://cdn.tailwindcss.com")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet")
    style.
      body { font-family: 'Poppins', sans-serif; }
      .bg-uneg { background-color: #003366; }
      .text-uneg { color: #003366; }
      .border-uneg { border-color: #003366; }

  body(class="bg-gray-100 min-h-screen flex flex-col")
    // Header Institucional
    header(class="bg-uneg shadow-lg p-4 mb-auto")
      .max-w-6xl.mx-auto.flex.items-center.justify-between
        .flex.items-center.gap-4
          // Logo de la UNEG
          img(src="/images/uneg-logo.png" alt="Logo UNEG" class="h-14 w-auto bg-white p-1 rounded-md" onerror="this.src='https://via.placeholder.com/150x150?text=UNEG'")
          div
            h2(class="text-white font-bold text-lg leading-tight") Universidad Nacional Experimental 
            p(class="text-blue-200 text-sm") de Guayana
        div(class="hidden md:block text-right")
          span(class="text-white text-xs uppercase tracking-widest opacity-75") Vicerrectorado Académico
    
    // Contenedor del Formulario
    main(class="flex-grow flex items-center justify-center p-6")
      .bg-white(class="rounded-2xl shadow-xl overflow-hidden max-w-lg w-full transform transition-all")
        // Línea decorativa superior
        div(class="h-2 bg-uneg")
        
        div(class="p-8 md:p-10 text-center")
          h1(class="text-3xl font-extrabold text-uneg mb-2") Sistema Antiplagio
          span(class="inline-block px-3 py-1 bg-blue-100 text-uneg text-xs font-bold rounded-full mb-6") UNEGIA v1.0
          
          p(class="text-gray-500 mb-8 text-sm") Cargue el archivo e indique el tema central para procesar la Ley de Price y Bradford.

          // Formulario de Carga
          form(action="/upload" method="POST" enctype="multipart/form-data" class="text-left")
            
            // --- NUEVO CAMPO: TEMA DEL PROYECTO ---
            div(class="mb-6")
              label(for="tema_proyecto" class="block text-uneg text-sm font-bold mb-2 ml-1") Tema del Proyecto
              div(class="relative")
                div(class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none")
                  span(class="text-gray-400") 🎯
                input#tema_proyecto(
                  type="text" 
                  name="tema_proyecto" 
                  placeholder="Ej: Ciberseguridad, Redes, Transporte..." 
                  required
                  class="w-full pl-10 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:border-uneg focus:ring-0 transition-all outline-none text-sm text-gray-700"
                )
            
            // --- ÁREA DE CARGA PDF ---
            label(for="file-upload" class="group border-2 border-dashed border-gray-300 rounded-xl p-8 mb-6 block cursor-pointer transition-all hover:border-uneg hover:bg-blue-50 text-center")
              div(class="text-4xl mb-3 group-hover:scale-110 transition-transform") 📄
              span#file-name(class="text-gray-600 font-medium block text-sm") Seleccionar Documento PDF
              span(class="text-xs text-gray-400 mt-1 block") (Máximo 10MB)
              
              input#file-upload(
                type="file" 
                name="pdf" 
                accept="application/pdf" 
                required 
                class="hidden" 
                onchange="const name = this.files[0].name; document.getElementById('file-name').innerText = name; document.getElementById('file-name').classList.add('text-uneg', 'font-bold');"
              )

            button(type="submit" class="w-full bg-uneg text-white text-lg font-bold py-4 px-6 rounded-xl shadow-md hover:bg-blue-900 transition-all flex items-center justify-center gap-2 group")
              span 🚀 Iniciar Análisis
              span(class="group-hover:translate-x-1 transition-transform") →

    // Footer
    footer(class="p-6 text-center text-gray-400 text-xs")
      p Coordinación de Informática - UNEG
      p &copy; 2026 UNEGIA. Todos los derechos reservados.